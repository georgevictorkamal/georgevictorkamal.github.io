# Portfolio Application - Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ===== DATABASE =====
# MySQL connection string
# Format: mysql://username:password@host:port/database
DATABASE_URL=mysql://portfolio_user:your_password@localhost:3306/portfolio_db

# ===== SERVER =====
# Node environment
NODE_ENV=development

# Server port
PORT=3000

# ===== JWT CONFIGURATION =====
# JWT secret key for signing tokens (min 32 characters!)
JWT_SECRET=your_very_secure_jwt_secret_key_at_least_32_chars_long!

# JWT token expiration time
JWT_EXPIRATION=24h

# ===== SESSION CONFIGURATION =====
# Session secret for cookie signing (min 32 characters!)
SESSION_SECRET=your_session_secret_key_at_least_32_characters_long!

# Session expiration time (in milliseconds)
SESSION_MAX_AGE=86400000

# ===== CORS CONFIGURATION =====
# Allowed origins for CORS (comma-separated)
# For development:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4200

# For production:
ALLOWED_ORIGINS=https://georgevictorkamal.github.io

# ===== OAuth2 CONFIGURATION (Optional) =====
# OAuth provider credentials if using social login
OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
OAUTH_REDIRECT_URI=https://georgevictorkamal.github.io/api/oauth/callback

# ===== EMAIL CONFIGURATION (Optional) =====
# SMTP settings for sending emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=georgevictorkamal@gmail.com
# SMTP_FROM_EMAIL=noreply@georgevictorkamal.github.io

# ===== FRONTEND CONFIGURATION =====
# API URL for frontend (what the client uses to call the API)
# For development:
# VITE_API_URL=http://localhost:3000
# For production (static mode uses mock data):
VITE_API_URL=
VITE_OAUTH_PORTAL_URL=https://auth.example.com

# ===== MONITORING & LOGGING =====
# Error tracking service (e.g., Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Log level (debug, info, warn, error)
LOG_LEVEL=debug

# ===== RATE LIMITING (Optional) =====
# Rate limit requests per minute
RATE_LIMIT_PER_MINUTE=60

# ===== FILE UPLOADS (Optional) =====
# Max file upload size in MB
MAX_FILE_SIZE_MB=50

# AWS S3 configuration for file uploads
AWS_S3_BUCKET=your-bucket-name
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# ===== ANALYTICS (Optional) =====
# Google Analytics tracking ID
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X

# ===== FEATURE FLAGS (Optional) =====
# Enable/disable features
ENABLE_BLOG=false
ENABLE_TESTIMONIALS=false
# ===== AI & LLM CONFIGURATION (Optional) =====
# API settings for the AI Twin chat
AI_API_URL=https://api.openai.com
AI_API_KEY=your_ai_api_key_here

# ===== APPLICATION CONFIGURATION =====
VITE_APP_ID=your_portfolio_app_id
OWNER_OPEN_ID=your_owner_openid_for_admin_access
OAUTH_SERVER_URL=demo # Set to 'demo' to bypass or actual URL for live
